{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/Frontend/admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/Frontend/utama/$1"
    }
  ]
}